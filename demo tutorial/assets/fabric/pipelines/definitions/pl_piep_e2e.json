{
 "properties": {
  "activities": [
   {
    "name": "lkp_sealed_batch",
    "type": "Lookup",
    "dependsOn": [],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 0,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "typeProperties": {
     "source": {
      "type": "AzureSqlSource",
      "sqlReaderQuery": {
       "value": "@concat('SELECT batch_id, period_end, content_sha256 FROM ctl.source_batch WHERE state = ''SEALED'' AND batch_id = ''', pipeline().parameters.p_batch_id, '''')",
       "type": "Expression"
      },
      "queryTimeout": "02:00:00",
      "partitionOption": "None"
     },
     "firstRowOnly": true,
     "datasetSettings": {
      "annotations": [],
      "type": "AzureSqlTable",
      "schema": [],
      "typeProperties": {
       "database": "sqldb_piep_source_demo"
      },
      "externalReferences": {
       "connection": "<sql_connection>"
      }
     }
    }
   },
   {
    "name": "if_batch_sealed",
    "type": "IfCondition",
    "dependsOn": [
     {
      "activity": "lkp_sealed_batch",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "typeProperties": {
     "expression": {
      "value": "@contains(activity('lkp_sealed_batch').output, 'firstRow')",
      "type": "Expression"
     },
     "ifTrueActivities": [],
     "ifFalseActivities": [
      {
       "name": "fail_batch_not_sealed",
       "type": "Fail",
       "dependsOn": [],
       "typeProperties": {
        "message": {
         "value": "@concat('Batch ', pipeline().parameters.p_batch_id, ' is not SEALED in ctl.source_batch. Load it with python -m workshop load first.')",
         "type": "Expression"
        },
        "errorCode": "BATCH_NOT_SEALED"
       }
      }
     ]
    }
   },
   {
    "name": "lkp_entities",
    "type": "Lookup",
    "dependsOn": [
     {
      "activity": "if_batch_sealed",
      "dependencyConditions": [
       "Succeeded"
      ]
     }
    ],
    "policy": {
     "timeout": "0.12:00:00",
     "retry": 0,
     "retryIntervalInSeconds": 30,
     "secureOutput": false,
     "secureInput": false
    },
    "typeProperties": {
     "source": {
      "type": "AzureSqlSource",
      "sqlReaderQuery": "SELECT entity_name, source_schema, source_table FROM ctl.entity_config WHERE enabled = 1 ORDER BY ordinal",
      "queryTimeout": "02:00:00",
      "partitionOption": "None"
     },
     "firstRowOnly": false,
     "datasetSettings": {
      "annotations": [],
      "type": "AzureSqlTable",
      "schema": [],
      "typeProperties": {
       "database": "sqldb_piep_source_demo"
      },
      "externalReferences": {
       "connection": "<sql_connection>"
      }
     }
    }
   },
